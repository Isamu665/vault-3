{
  "name": "ReserveTransaction",
  "type": "object",
  "properties": {
    "reserve_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "type": {
      "type": "string",
      "enum": [
        "deposit",
        "withdrawal"
      ],
      "default": "deposit"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "reserve_id",
    "amount",
    "date",
    "type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}