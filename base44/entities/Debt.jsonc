{
  "name": "Debt",
  "type": "object",
  "properties": {
    "creditor": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "original_amount": {
      "type": "number"
    },
    "installment_amount": {
      "type": "number"
    },
    "installments_total": {
      "type": "number"
    },
    "installment_current": {
      "type": "number",
      "default": 0
    },
    "interest_rate": {
      "type": "number"
    },
    "cet": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "creditor",
    "installment_amount",
    "installments_total"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}