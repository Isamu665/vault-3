{
  "name": "Goal",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "seguran\u00e7a",
        "lazer",
        "moradia",
        "educa\u00e7\u00e3o",
        "aposentadoria",
        "outros"
      ],
      "default": "outros"
    },
    "target_amount": {
      "type": "number"
    },
    "current_amount": {
      "type": "number",
      "default": 0
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "where": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "target_amount"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}