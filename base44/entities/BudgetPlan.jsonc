{
  "name": "BudgetPlan",
  "type": "object",
  "properties": {
    "reference_month": {
      "type": "string",
      "format": "date"
    },
    "planned_income": {
      "type": "number",
      "default": 0
    },
    "planned_necessities": {
      "type": "number",
      "default": 0
    },
    "planned_wishes": {
      "type": "number",
      "default": 0
    },
    "planned_investments": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "reference_month"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}