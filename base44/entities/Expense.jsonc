{
  "name": "Expense",
  "type": "object",
  "properties": {
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "dinheiro",
        "pix",
        "d\u00e9bito",
        "cr\u00e9dito",
        "boleto",
        "transfer\u00eancia"
      ],
      "default": "pix"
    },
    "need_type": {
      "type": "string",
      "enum": [
        "necessidade",
        "desejo",
        "patrim\u00f4nio",
        "investimento"
      ],
      "default": "necessidade"
    },
    "recurring": {
      "type": "boolean",
      "default": false
    },
    "installment": {
      "type": "boolean",
      "default": false
    },
    "installments_total": {
      "type": "number"
    },
    "installment_current": {
      "type": "number"
    },
    "investment_id": {
      "type": "string"
    },
    "reserve_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "description",
    "amount",
    "date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}