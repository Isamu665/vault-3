{
  "name": "Reserve",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "target_amount": {
      "type": "number",
      "default": 0
    },
    "current_amount": {
      "type": "number",
      "default": 0
    },
    "deposit_date": {
      "type": "string",
      "format": "date"
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}